(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" "." "/" "22.20" "30.66" "<" "</" "</price>" "<price>" ">" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "<price>30.66</price>") "30.66"))
(constraint (= (f "<price>22.20</price>") "22.20"))
(check-synth)
