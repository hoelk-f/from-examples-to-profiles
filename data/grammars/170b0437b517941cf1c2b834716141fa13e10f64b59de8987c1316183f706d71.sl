(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " x" "-" "467-8177" "556-9304" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "186-556-9304 x4202") "556-9304"))
(constraint (= (f "829-467-8177 x1914") "467-8177"))
(check-synth)
