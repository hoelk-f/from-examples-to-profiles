(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " 4 196" "," ", " ", 19" "-" "0, " "Milan" "Vienna" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "Austria Ernst-Happel-Stadion, Vienna 4 1964, 1987, 1990, 1995") "Vienna"))
(constraint (= (f "Italy San Siro, Milan 4 1965, 1970, 2001, 2016") "Milan"))
(check-synth)
