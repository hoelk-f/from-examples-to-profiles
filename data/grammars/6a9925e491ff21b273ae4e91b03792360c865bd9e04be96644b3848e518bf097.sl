(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " (" " seconds)" "(" ")" "," "." "0,000 results (0." "1," "1,620,000" "31,900,000" "About " (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "About 31,900,000 results (0.70 seconds)") "31,900,000"))
(constraint (= (f "About 1,620,000 results (0.66 seconds)") "1,620,000"))
(check-synth)
