(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " (" " (19" "(" ")" "1915" "1973" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "Beginning at the End (1915)") "1915"))
(constraint (= (f "Homes (1973)") "1973"))
(check-synth)
