(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " '''" " (" " / " " [[" "'" "'' as " "'''" "(" ")" ")|" "*" "* " "* '''" "** [[" "/" "Azaad" "Dhool Ka Phool" "Sadhna" "Sahara" "[" "]" "]] – ''[[" "]]''" "]]'' " "]]''''' " "|" "–" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "** [[Meena Kumari]] – ''[[Azaad (1955 film)|Azaad]]'' as Shobha") "Azaad"))
(constraint (= (f "** [[Meena Kumari]] – ''[[Sahara (1958 film)|Sahara]]'' as Leela") "Sahara"))
(constraint (= (f "** [[Mala Sinha]] – ''[[Dhool Ka Phool]]'' as Meena Khosla") "Dhool Ka Phool"))
(constraint (= (f "* '''1958 [[Vyjayanthimala]] – ''[[Sadhna]]''''' as '''Champabai / Rajani'''") "Sadhna"))
(check-synth)
