(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " 2" " A" " J" "," ",2" ",4" "." ". " "26,418" "29,272" "81," "ical " (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "6 J. American Chemical Society 29,272 881,457") "29,272"))
(constraint (= (f "8 Astrophysical Journal 26,418 581,299") "26,418"))
(check-synth)
