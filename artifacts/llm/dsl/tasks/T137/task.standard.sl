(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " "-" "-e" "." ".tex" "25 Apr" "5 " "8 Mar" ":" "K " "r " (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "4.9K 25 Apr 2015 fig-e4.tex") "25 Apr"))
(constraint (= (f "6.5K 8 Mar 16:55 05-e1.tex") "8 Mar"))
(check-synth)
