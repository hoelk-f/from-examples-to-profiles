(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " (" " S" "(" ")" ") " "," "." ". " ". A" "1," "2" "2 " "6" "6 " (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "2 Proc. Natl. Acad. Sci. USA (PNAS) 30,396 1,376,541") "2"))
(constraint (= (f "6 J. American Chemical Society 29,272 881,457") "6"))
(check-synth)
