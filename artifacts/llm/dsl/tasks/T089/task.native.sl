(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " Oct 1" "-" "." ":" "K 1" "ics" "pdf" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "582K 18 Oct 12:13 make-01.pdf") "pdf"))
(constraint (= (f "71K 16 Oct 17:29 events.ics") "ics"))
(check-synth)
