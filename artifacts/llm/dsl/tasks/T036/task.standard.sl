(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " OS " "-" "-internal " "." ".2." "/" "2.9.7" "8.2.1" "9." "MFM-Robot/" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "MFM-Robot/9.1.40-internal AI055 OS 8.2.1") "8.2.1"))
(constraint (= (f "MFM-Robot/4.2.96-internal JI YNSD OS 2.9.7") "2.9.7"))
(check-synth)
