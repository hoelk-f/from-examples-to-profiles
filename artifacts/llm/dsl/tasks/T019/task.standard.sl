(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " (" " 4" "(" "(2" ")" ") " "0 " "24" "27" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "(24) 950 4346") "24"))
(constraint (= (f "419 138 420700 5327 (27) 0033") "27"))
(check-synth)
