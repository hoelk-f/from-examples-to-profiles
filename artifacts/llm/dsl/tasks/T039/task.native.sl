(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " aka " " of " "-" ":" ": " "Indiana Jones and the Kingdom of the Crystal Skull" "X-Men: Days of Future Past" "e " "s " (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "New X man aka X-Men: Days of Future Past") "X-Men: Days of Future Past"))
(constraint (= (f "Indy 4 aka Indiana Jones and the Kingdom of the Crystal Skull") "Indiana Jones and the Kingdom of the Crystal Skull"))
(check-synth)
