(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " (" " years old)" "(" ")" "," "60" "75" "ber,19" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "28 December,1958 (60 years old)") "60"))
(constraint (= (f "21 October,1943 (75 years old)") "75"))
(check-synth)
