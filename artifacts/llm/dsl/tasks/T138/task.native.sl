(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " "10 Nov 10:58" "10 Nov 10:59" ":" "B 10 Nov 10:5" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "352B 10 Nov 10:58 theses") "10 Nov 10:58"))
(constraint (= (f "288B 10 Nov 10:59 writing") "10 Nov 10:59"))
(check-synth)
