(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " 0" "1" "1 1" "1Z " "4" "7 " (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "1Z 6YB OGO 04 3027 631 1") "1"))
(constraint (= (f "1Z NR7 001 13 9832 097 4") "4"))
(check-synth)
