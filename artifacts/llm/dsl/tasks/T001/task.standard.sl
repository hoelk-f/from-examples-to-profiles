(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" "-" "01" "29" ":" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "1957-10-29T07:35:06Z") "29"))
(constraint (= (f "1939-04-01T11:59:57Z") "01"))
(check-synth)
