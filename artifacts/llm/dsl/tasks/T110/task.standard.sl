(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " "6150" "6310" ":" ": " "Brand: Nokia Model: 6" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "Brand: Nokia Model: 6310") "6310"))
(constraint (= (f "Brand: Nokia Model: 6150") "6150"))
(check-synth)
