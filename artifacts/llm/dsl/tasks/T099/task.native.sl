(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " followers " " following" " posts " "144 posts" "570 posts" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "144 posts 248 followers 872 following") "144 posts"))
(constraint (= (f "570 posts 479 followers 1025 following") "570 posts"))
(check-synth)
