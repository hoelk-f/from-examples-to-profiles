(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " " 19" " Conservative" " Ma" "-" "-19" "Harold Macmillan" "Margaret Thatcher" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "4 Harold Macmillan 1957-1963 Conservative") "Harold Macmillan"))
(constraint (= (f "2 Margaret Thatcher 1979-1990 Conservative") "Margaret Thatcher"))
(check-synth)
