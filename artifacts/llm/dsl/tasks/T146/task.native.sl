(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " "," ", " ", 20" ", September 1" "-" "-1" "ILP 20" "September 10-12, 2008" "September 14-16, 2014" "e, " (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "ILP 2008, Prague, Czech Republic, September 10-12, 2008") "September 10-12, 2008"))
(constraint (= (f "ILP 2014, Nancy, France, September 14-16, 2014") "September 14-16, 2014"))
(check-synth)
