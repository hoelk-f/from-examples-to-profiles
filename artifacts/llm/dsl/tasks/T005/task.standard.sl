(set-logic SLIA)
(synth-fun f ((x String)) String ((S String (x "" " " "-" "-20" "08" "49" ":" ":1" (str.++ S S) (str.at S I) (str.substr S I I) (str.replace S S S) (ite B S S))) (I Int (-1 0 1 2 3 4 5 (str.len S) (str.indexof S S I) (+ I I) (- I I))) (B Bool ((str.contains S S) (str.prefixof S S) (str.suffixof S S) (= S S) (= I I)))))
(constraint (= (f "22-Nov-2030 08:18:08") "08"))
(constraint (= (f "03-Mar-2024 10:17:49") "49"))
(check-synth)
